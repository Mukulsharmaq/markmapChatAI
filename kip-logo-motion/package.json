{
  "name": "kip-logo-motion",
  "version": "1.0.0",
  "description": "Motion-design logo sting for the 'Killing Imaginary People' podcast — a sniper-scope reticle that powers on, locks its target and reveals the title. Built with Remotion.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render src/index.ts KipLogo out/kip-logo-endcard.mp4 --codec=h264 --crf=16",
    "render:transparent-mov": "remotion render src/index.ts KipLogoTransparent out/kip-logo-overlay.mov --codec=prores --prores-profile=4444",
    "render:transparent-webm": "remotion render src/index.ts KipLogoTransparent out/kip-logo-overlay.webm --codec=vp9 --pixel-format=yuva420p --crf=18",
    "still": "remotion still src/index.ts KipLogo out/kip-endframe.png --frame=175",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/zod-types": "^4.0.484",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.4.0"
  }
}
