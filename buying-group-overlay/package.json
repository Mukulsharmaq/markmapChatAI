{
  "name": "buying-group-overlay",
  "version": "1.0.0",
  "description": "Transparent Remotion motion-graphic overlays for a podcast clip about buying group mapping",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render:master": "remotion render src/index.ts BuyingGroupOverlay out/buying-group-overlay.mov --codec=prores --prores-profile=4444",
    "render:master-webm": "remotion render src/index.ts BuyingGroupOverlay out/buying-group-overlay.webm --codec=vp8 --pixel-format=yuva420p",
    "render:scene01": "remotion render src/index.ts Scene01-Title out/scene01-title.mov --codec=prores --prores-profile=4444",
    "render:scene02": "remotion render src/index.ts Scene02-CustomerIntel out/scene02-customer-intel.mov --codec=prores --prores-profile=4444",
    "render:scene03": "remotion render src/index.ts Scene03-PowerUsers out/scene03-power-users.mov --codec=prores --prores-profile=4444",
    "render:scene04": "remotion render src/index.ts Scene04-Departments out/scene04-departments.mov --codec=prores --prores-profile=4444",
    "render:scene05": "remotion render src/index.ts Scene05-Committee out/scene05-committee.mov --codec=prores --prores-profile=4444",
    "render:scene06": "remotion render src/index.ts Scene06-Validation out/scene06-validation.mov --codec=prores --prores-profile=4444",
    "render:all-scenes": "npm run render:scene01 && npm run render:scene02 && npm run render:scene03 && npm run render:scene04 && npm run render:scene05 && npm run render:scene06",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/zod-types": "^4.0.484",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.4.0"
  }
}
